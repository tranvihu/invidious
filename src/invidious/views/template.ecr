<%
  preferences = env.get("preferences").as(Preferences)
  locale = preferences.locale
  dark_mode = preferences.dark_mode
%>
<!DOCTYPE html>
<html lang="<%= locale %>">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= yield_content "header" %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=<%= ASSET_COMMIT %>">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=<%= ASSET_COMMIT %>">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=<%= ASSET_COMMIT %>">
    <link rel="manifest" href="/site.webmanifest?v=<%= ASSET_COMMIT %>">
    <link rel="mask-icon" href="/safari-pinned-tab.svg?v=<%= ASSET_COMMIT %>" color="#575757">
    <meta name="msapplication-TileColor" content="#575757">
    <meta name="theme-color" content="#575757">
    <link title="Invidious" type="application/opensearchdescription+xml" rel="search" href="/opensearch.xml">
    <link rel="stylesheet" href="/css/pure-min.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/grids-responsive-min.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/ionicons.min.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/default.css?v=<%= ASSET_COMMIT %>">
    <link rel="stylesheet" href="/css/carousel.css?v=<%= ASSET_COMMIT %>">
    <script src="/js/_helpers.js?v=<%= ASSET_COMMIT %>"></script>
</head>

<body class="<%= dark_mode == "dark" ? "theme-dark" : "theme-light" %>">
    <span style="display:none" id="dark_mode_pref"><%= dark_mode %></span>
    <div id="app-layout">
        <!-- SIDEBAR TRÁI -->
        <aside id="custom-sidebar">
            <a href="/" style="text-decoration: none;">
                <div class="sidebar-logo">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="#ff0000"><path d="M8 5v14l11-7z"/></svg> Kevin-tube
            </div>
            </a>
            <ul class="sidebar-menu">
                <li><a href="/" class="<%= (env.get?("current_page") == "/" || env.get?("current_page") == "/feed/trending") && env.params.query["region"]? != "US" ? "active" : "" %>"><span style="margin-right:15px; font-size:18px">🇻🇳</span> Việt Nam</a></li>
                <li><a href="/feed/trending?region=US" class="<%= env.params.query["region"]? == "US" ? "active" : "" %>"><span style="margin-right:15px; font-size:18px">🌍</span> Thế giới</a></li>
                <li><a href="/feed/subscriptions" class="<%= env.get?("current_page") == "/feed/subscriptions" ? "active" : "" %>"><span style="margin-right:15px; font-size:18px">👺</span> Đăng ký</a></li>
                <hr>
                <li><a href="/search?q=nhạc+thiếu+nhi"><span style="margin-right:15px; font-size:18px">📑</span> Dành cho bé</a></li>
                <li><a href="/search?q=khoa+học+khám+phá"><span style="margin-right:15px; font-size:18px">🎄</span> Học tập</a></li>
                <li><a href="/search?q=bảng+xếp+hạng+âm+nhạc"><span style="margin-right:15px; font-size:18px">🎵</span> Âm nhạc</a></li>
            </ul>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main id="main-content">
            <!-- THANH TÌM KIẾM & NÚT BẤM -->
            <div class="top-nav">
                <div style="width: 20px;"></div>
                <div class="search-container">
                    <% autofocus = false %><%= rendered "components/search_box" %>
                </div>
                <div class="user-actions">
                    <a href="/toggle_theme?referer=<%= env.get?("current_page") %>" title="Đổi giao diện" class="btn-icon">
                        <% if dark_mode == "dark" %>
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.39.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.39.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41.39.39 1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41.39.39 1.03.39 1.41 0l1.06-1.06z"/></svg>
                        <% else %>
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"/></svg>
                        <% end %>
                    </a>
                    
                    <% if env.get? "user" %>
                        <a href="/feed/subscriptions" title="Đăng ký" class="btn-icon">
                            <% notification_count = env.get("user").as(Invidious::User).notifications.size %>
                            <% if CONFIG.enable_user_notifications && notification_count > 0 %>
                                <span class="badge"><%= notification_count %></span>
                            <% else %>
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/></svg>
                            <% end %>
                        </a>
                        <a href="/preferences?referer=<%= env.get?("current_page") %>" title="Cài đặt" class="btn-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.73 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .43-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.49-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg></a>
                        <form action="/signout?referer=<%= env.get?("current_page") %>" method="post" style="display:inline;">
                            <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                            <button type="submit" class="btn-icon" title="Đăng xuất"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg></button>
                        </form>
                    <% else %>
                        <a href="/preferences?referer=<%= env.get?("current_page") %>" title="Cài đặt" class="btn-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.73 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .43-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.49-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg></a>
                        <% if CONFIG.login_enabled %>
                            <a href="/login?referer=<%= env.get?("current_page") %>" class="btn-icon" style="width:auto; padding: 0 15px; border-radius: 20px; font-weight: 600; font-size: 13px;">Đăng nhập</a>
                        <% end %>
                    <% end %>
                </div>
            </div>

            <!-- HERO BANNER TỐI GIẢN (Only on homepages) -->
            <% current_path = env.get?("current_page").try(&.as(String)) || "" %>
            <% if current_path == "/" || current_path == "/feed/popular" || current_path == "/feed/trending" %>
            <div id="kevin-custom-banner">
                <div class="banner-content">
                    <h1 class="banner-title" id="banner-title">Welcome to Kevin-tube</h1>
                    <p class="banner-subtitle" id="banner-subtitle">Khám phá thế giới video an toàn cho gia đình bạn.</p>
                </div>
            </div>
            <h2 class="section-title">Video đề xuất</h2>
            <% end %>

            <!-- INVIDIOUS CONTENT INJECTED HERE -->
            <% current_path = env.get?("current_page").try(&.as(String)) || "" %>
            <% is_grid = ["/", "/feed/popular", "/feed/trending", "/feed/subscriptions", "/feed/history", "/feed/playlists"].includes?(current_path) || current_path.starts_with?("/search") || current_path.starts_with?("/channel") %>
            <div id="contents" class="<%= is_grid ? "video-grid-wrapper" : "watch-page-layout" %>">
                <% if CONFIG.banner %>
                    <div class="h-box">
                        <h3><%= CONFIG.banner %></h3>
                    </div>
                <% end %>
                <%= content %>
            </div>

            <!-- CHÂN TRANG (FOOTER) -->
            <footer class="simple-footer">
                <div class="footer-links">
                    <a href="/" class="footer-link">Trang chủ</a>
                    <a href="/privacy" class="footer-link">Bảo mật</a>
                    <a href="/licenses" class="footer-link">Bản quyền</a>
                </div>
                <p class="footer-copyright">© 2026 Kevin-tube. Giao diện tùy chỉnh đặc biệt.</p>
            </footer>
        </main>
    </div>

    <script src="/js/handlers.js?v=<%= ASSET_COMMIT %>"></script>
    <script src="/js/themes.js?v=<%= ASSET_COMMIT %>"></script>
    <% if env.get? "user" %>
        <script src="/js/sse.js?v=<%= ASSET_COMMIT %>"></script>
        <script id="notification_data" type="application/json">
        <%=
        {
            "upload_text" => HTML.escape(I18n.translate(locale, "`x` uploaded a video")),
            "live_upload_text" => HTML.escape(I18n.translate(locale, "`x` is live"))
        }.to_pretty_json
        %>
        </script>
        <% if CONFIG.enable_user_notifications %>
        <script src="/js/notifications.js?v=<%= ASSET_COMMIT %>"></script>
        <% end %>
    <% end %>

    <!-- MINIMALIST CSS OVERRIDES -->
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 0; font-family: 'Inter', system-ui, sans-serif; }
        #app-layout { display: flex; min-height: 100vh; }
        
        /* SIDEBAR */
        #custom-sidebar { width: 220px; padding: 20px 15px; flex-shrink: 0; display: flex; flex-direction: column; gap: 10px; }
        .sidebar-logo { font-size: 20px; font-weight: 800; display: flex; align-items: center; gap: 10px; margin-bottom: 15px; padding-left: 10px; letter-spacing: -0.5px; }
        .sidebar-menu { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
        .sidebar-menu hr { width: 100%; border: 0; border-top: 1px solid; opacity: 0.1; margin: 12px 0; }
        .sidebar-menu a { text-decoration: none; font-size: 14px; display: flex; align-items: center; padding: 10px 12px; border-radius: 10px; transition: background 0.2s; }
        .sidebar-menu i { font-size: 20px; margin-right: 15px; width: 24px; text-align: center; }
        
        /* MAIN CONTENT */
        #main-content { flex: 1; padding: 15px 30px; display: flex; flex-direction: column; max-width: calc(100vw - 220px); }
        .top-nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; height: 50px; flex-shrink: 0; }
        .search-container { position: relative; width: 100%; max-width: 500px; display: flex; }
        
        /* OVERRIDE INVIDIOUS SEARCH FORM */
        .search-container form.pure-form { width: 100%; display: flex; margin: 0; }
        .search-container form fieldset { width: 100%; margin: 0; padding: 0; border: none; }
        .search-container input[type="search"] { width: 100%; border-radius: 40px 0 0 40px !important; padding: 10px 20px !important; font-size: 15px !important; outline: none; height: 42px; border-right: none !important; }
        .search-container button[type="submit"] { border-radius: 0 40px 40px 0 !important; padding: 0 20px !important; cursor: pointer; display: flex; align-items: center; height: 42px; }
        
        .user-actions { display: flex; align-items: center; gap: 10px; }
        .btn-icon { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 1px solid; background: transparent; cursor: pointer; transition: all 0.2s; font-size: 18px; outline: none; text-decoration: none; }
        .btn-icon:active { transform: scale(0.92); }
        
        /* BANNER */
        #kevin-custom-banner { border-radius: 12px; padding: 30px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
        .banner-content { max-width: 600px; }
        .banner-title { font-size: 1.8em; margin: 0 0 8px 0; font-weight: 800; letter-spacing: -0.5px; }
        .banner-subtitle { font-size: 1.05em; margin: 0; opacity: 0.8; }
        .section-title { font-size: 18px; font-weight: 800; margin-bottom: 20px; margin-top: 0; }
        
        
        /* WATCH PAGE DOWNLOAD WIDGET FIX */
        .watch-page-layout form[action^="/download"] { background: #f8f8f8; padding: 15px; border-radius: 12px; border: 1px solid #eee; margin: 15px 0; }
        .watch-page-layout form[action^="/download"] label { font-weight: bold; margin-bottom: 8px; display: block; }
        .watch-page-layout form[action^="/download"] select { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; margin-bottom: 10px; background: #fff; }
        .watch-page-layout form[action^="/download"] button { width: 100%; padding: 12px; border-radius: 8px; background: #ff0000; color: white; border: none; font-weight: bold; cursor: pointer; transition: background 0.2s; }
        .watch-page-layout form[action^="/download"] button:hover { background: #cc0000; }
        body.theme-dark .watch-page-layout form[action^="/download"] { background: #1a1a1a; border-color: #333; }
        body.theme-dark .watch-page-layout form[action^="/download"] select { background: #222; color: #fff; border-color: #444; }

        /* WATCH PAGE SIDEBAR LINKS */
        .watch-page-layout .pure-u-1.pure-u-lg-1-5 a { display: inline-block; padding: 10px; background: #f2f2f2; border-radius: 8px; margin-bottom: 8px; text-decoration: none; font-weight: 600; font-size: 13px; width: 100%; text-align: center; box-sizing: border-box; }
        .watch-page-layout .pure-u-1.pure-u-lg-1-5 a:hover { background: #e5e5e5; }
        body.theme-dark .watch-page-layout .pure-u-1.pure-u-lg-1-5 a { background: #222; color: #ddd; border: 1px solid #333; }
        body.theme-dark .watch-page-layout .pure-u-1.pure-u-lg-1-5 a:hover { background: #2a2a2a; color: #fff; }
    
        /* WATCH PAGE LAYOUT FIX */
        .watch-page-layout .pure-g { display: flex; flex-wrap: wrap; }
        .watch-page-layout .thumbnail { border-radius: 8px !important; }

        /* OVERRIDE INVIDIOUS VIDEO GRIDS (The Magic Trick) */
        .video-grid-wrapper .pure-g { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px 15px; width: 100%; }
        .video-grid-wrapper .pure-u-1, .video-grid-wrapper .pure-u-sm-1-2, .video-grid-wrapper .pure-u-md-1-3, .video-grid-wrapper .pure-u-lg-1-4 { width: auto !important; max-width: none !important; flex: none !important; }
        
        /* VIDEO CARD STYLE */
        .video-grid-wrapper .thumbnail { border-radius: 12px !important; transition: border-radius 0.2s; }
        .video-grid-wrapper a:hover .thumbnail { border-radius: 4px !important; }
        .video-card-row { margin-top: 8px !important; }
        .video-card-row p { font-size: 14px; font-weight: 600; line-height: 1.4; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .channel-name { font-size: 13px !important; opacity: 0.7; font-weight: normal !important; margin-top: 4px !important; }
        .video-data { font-size: 12px !important; opacity: 0.6; font-weight: normal !important; }
        
        /* FOOTER */
        .simple-footer { margin-top: auto; padding: 25px 0 10px 0; border-top: 1px solid; text-align: center; display: flex; flex-direction: column; gap: 8px; font-size: 13px; }
        .footer-links { display: flex; justify-content: center; gap: 15px; font-weight: 600; }
        .footer-links a { text-decoration: none; transition: opacity 0.2s; }
        .footer-links a:hover { opacity: 1; text-decoration: underline; }
        .footer-copyright { margin: 0; opacity: 0.6; }
        
        /* LIGHT THEME */
        body.theme-light { background: #fdfdfd; color: #0f0f0f; }
        body.theme-light #custom-sidebar { background: #ffffff; border-right: 1px solid #eaeaea; }
        body.theme-light .sidebar-logo { color: #0f0f0f; }
        body.theme-light .sidebar-menu a { color: #0f0f0f; }
        body.theme-light .sidebar-menu a:hover, body.theme-light .sidebar-menu a.active { background: #f2f2f2; font-weight: 600; }
        body.theme-light .search-container input[type="search"] { background: #ffffff; border: 1px solid #cccccc; color: #0f0f0f; box-shadow: inset 0 1px 2px #eee; }
        body.theme-light .search-container input[type="search"]:focus { border-color: #1c62b9; }
        body.theme-light .search-container button[type="submit"] { background: #f8f8f8; border: 1px solid #cccccc; color: #333; }
        body.theme-light .search-container button[type="submit"]:hover { background: #f0f0f0; }
        body.theme-light .btn-icon { color: #0f0f0f; border-color: #e5e5e5; }
        body.theme-light .btn-icon:hover { background: #f2f2f2; border-color: #ccc; }
        body.theme-light #kevin-custom-banner { background: #f4f6f8; }
        body.theme-light .banner-title { color: #0f0f0f; }
        body.theme-light .banner-subtitle { color: #606060; }
        body.theme-light .simple-footer { border-color: #eaeaea; }
        body.theme-light .footer-links a { color: #555; }
        body.theme-light a { color: #0f0f0f; }
        
        /* DARK THEME */
        body.theme-dark { background: #0f0f0f; color: #f1f1f1; }
        body.theme-dark #custom-sidebar { background: #0f0f0f; border-right: 1px solid #272727; }
        body.theme-dark .sidebar-logo { color: #fff; }
        body.theme-dark .sidebar-menu a { color: #f1f1f1; }
        body.theme-dark .sidebar-menu a:hover, body.theme-dark .sidebar-menu a.active { background: #272727; font-weight: 600; }
        body.theme-dark .search-container input[type="search"] { background: #121212; border: 1px solid #303030; color: #fff; box-shadow: inset 0 1px 2px #000; }
        body.theme-dark .search-container input[type="search"]:focus { border-color: #1c62b9; }
        body.theme-dark .search-container button[type="submit"] { background: #222222; border: 1px solid #303030; color: #fff; }
        body.theme-dark .search-container button[type="submit"]:hover { background: #272727; }
        body.theme-dark .btn-icon { color: #f1f1f1; border-color: #3f3f3f; }
        body.theme-dark .btn-icon:hover { background: #272727; border-color: #555; }
        body.theme-dark #kevin-custom-banner { background: #212121; }
        body.theme-dark .banner-title { color: #fff; }
        body.theme-dark .banner-subtitle { color: #aaaaaa; }
        body.theme-dark .simple-footer { border-color: #272727; }
        body.theme-dark .footer-links a { color: #aaa; }
        body.theme-dark a { color: #f1f1f1; }
        
        /* Fix overlapping issues on mobile */
        @media (max-width: 768px) {
            #app-layout { flex-direction: column; }
            #custom-sidebar { width: 100%; border-right: none; border-bottom: 1px solid #ccc; padding: 10px; flex-direction: row; overflow-x: auto; }
            .sidebar-logo { margin-bottom: 0; margin-right: 20px; }
            .sidebar-menu { flex-direction: row; gap: 10px; }
            .sidebar-menu hr { display: none; }
            .sidebar-menu a { white-space: nowrap; padding: 5px 10px; }
            #main-content { max-width: 100%; padding: 15px; }
            .top-nav { gap: 10px; }
            .search-container { flex: 1; }
            .video-grid-wrapper .pure-g { grid-template-columns: 1fr; }
        }
    </style>
</body>
</html>







